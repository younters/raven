#include <windows.h>
1 DIALOG 0, 0, 160, 80
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Dynamic dialog contract"
BEGIN
    EDITTEXT 100, 8, 8, 120, 12, WS_TABSTOP | NOT WS_VISIBLE
    CONTROL "Check", 101, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP | NOT WS_VISIBLE, 8, 28, 60, 12
    DEFPUSHBUTTON "OK", IDOK, 100, 56, 50, 14, WS_TABSTOP | NOT WS_VISIBLE
END
STRINGTABLE
BEGIN
    1 "pointer width"
END
2 MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Exit", 200
    END
END
