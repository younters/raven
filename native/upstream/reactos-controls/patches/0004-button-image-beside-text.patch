+#ifdef __REACTOS__
+/* The image a text button got from BM_SETIMAGE goes to the left of the text, the two aligned together as the text alone would
+ * be. The rectangle is narrowed to where the text then goes. */
+static void BUTTON_DrawImageBeside(const BUTTON_INFO *infoPtr, HDC hdc, UINT dtFlags, RECT *rc, const WCHAR *text, BOOL enabled)
+{
+    static const LONG gap = 4;
+    SIZE image = {0, 0};
+    RECT measure = {0, 0, 0, 0};
+    ICONINFO icon;
+    BITMAP bm;
+    LONG width, x, y;
+
+    if (infoPtr->image_type == IMAGE_ICON)
+    {
+        if (!GetIconInfo(infoPtr->u.icon, &icon))
+            return;
+        if (GetObjectW(icon.hbmColor ? icon.hbmColor : icon.hbmMask, sizeof(bm), &bm))
+        {
+            image.cx = bm.bmWidth;
+            image.cy = icon.hbmColor ? bm.bmHeight : bm.bmHeight / 2;
+        }
+        if (icon.hbmColor) DeleteObject(icon.hbmColor);
+        DeleteObject(icon.hbmMask);
+    }
+    else if (GetObjectW(infoPtr->u.bitmap, sizeof(bm), &bm))
+    {
+        image.cx = bm.bmWidth;
+        image.cy = bm.bmHeight;
+    }
+    if (image.cx <= 0 || image.cy <= 0)
+        return;
+    DrawTextW(hdc, text, -1, &measure, DT_CALCRECT | DT_SINGLELINE);
+    width = image.cx + (text[0] ? gap + measure.right : 0);
+    if (dtFlags & DT_RIGHT)
+        x = rc->right - width;
+    else if (dtFlags & DT_CENTER)
+        x = (rc->left + rc->right - width) / 2;
+    else
+        x = rc->left;
+    y = (rc->top + rc->bottom - image.cy) / 2;
+    DrawStateW(hdc, NULL, NULL, (LPARAM)infoPtr->u.image, 0, x, y, image.cx, image.cy,
+               (infoPtr->image_type == IMAGE_ICON ? DST_ICON : DST_BITMAP) | (enabled ? DSS_NORMAL : DSS_DISABLED));
+    rc->left = x + image.cx + gap;
+    rc->right = rc->left + measure.right;
+}
+#endif
