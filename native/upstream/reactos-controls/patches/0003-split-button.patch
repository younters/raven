+#ifdef __REACTOS__
+#ifndef BCSS_NOSPLIT
+#define BCSS_NOSPLIT   0x0001
+#define BCSS_ALIGNLEFT 0x0004
+#endif
+
+static BOOL BUTTON_IsSplit(LONG style)
+{
+    return get_button_type(style) == BS_SPLITBUTTON || get_button_type(style) == BS_DEFSPLITBUTTON;
+}
+
+/* A split button keeps a drop-down part at its right edge (its left edge with BCSS_ALIGNLEFT), as wide as a scroll bar
+ * unless BCM_SETSPLITINFO gives a size; the label takes the rest. */
+static void BUTTON_SplitRects(const BUTTON_INFO *infoPtr, const RECT *client, RECT *label, RECT *drop)
+{
+    LONG width = infoPtr->split_size.cx > 0 ? infoPtr->split_size.cx : GetSystemMetrics(SM_CXVSCROLL);
+
+    if (width > client->right - client->left)
+        width = client->right - client->left;
+    *label = *drop = *client;
+    if (infoPtr->split_style & BCSS_ALIGNLEFT)
+    {
+        drop->right = drop->left + width;
+        label->left = drop->right;
+    }
+    else
+    {
+        drop->left = drop->right - width;
+        label->right = drop->left;
+    }
+}
+
+/* The separator between the two parts, unless BCSS_NOSPLIT, and a small arrow pointing down in the drop-down part. */
+static void BUTTON_DrawSplit(const BUTTON_INFO *infoPtr, HDC hdc, const RECT *drop, BOOL enabled)
+{
+    POINT arrow[3];
+    LONG cx = (drop->left + drop->right) / 2, cy = (drop->top + drop->bottom) / 2;
+    LONG half = (drop->right - drop->left) / 5;
+    HBRUSH brush, old_brush;
+    HPEN pen, old_pen;
+
+    if (half < 2) half = 2;
+    if (!(infoPtr->split_style & BCSS_NOSPLIT))
+    {
+        RECT line = *drop;
+        if (infoPtr->split_style & BCSS_ALIGNLEFT)
+            line.left = line.right - 1;
+        else
+            line.right = line.left + 1;
+        InflateRect(&line, 0, -4);
+        FillRect(hdc, &line, GetSysColorBrush(COLOR_BTNSHADOW));
+    }
+    arrow[0].x = cx - half;     arrow[0].y = cy - half / 2;
+    arrow[1].x = cx + half;     arrow[1].y = cy - half / 2;
+    arrow[2].x = cx;            arrow[2].y = cy + half / 2 + 1;
+    brush = GetSysColorBrush(enabled ? COLOR_BTNTEXT : COLOR_GRAYTEXT);
+    pen = CreatePen(PS_SOLID, 1, GetSysColor(enabled ? COLOR_BTNTEXT : COLOR_GRAYTEXT));
+    old_brush = SelectObject(hdc, brush);
+    old_pen = SelectObject(hdc, pen);
+    Polygon(hdc, arrow, 3);
+    SelectObject(hdc, old_pen);
+    SelectObject(hdc, old_brush);
+    DeleteObject(pen);
+}
+
+/* BCN_DROPDOWN tells the parent to show the menu of the drop-down part, whose rectangle it receives. */
+static void BUTTON_NotifyDropDown(const BUTTON_INFO *infoPtr)
+{
+    NMBCDROPDOWN notify;
+    RECT client, label;
+
+    GetClientRect(infoPtr->hwnd, &client);
+    notify.hdr.hwndFrom = infoPtr->hwnd;
+    notify.hdr.idFrom = GetWindowLongPtrW(infoPtr->hwnd, GWLP_ID);
+    notify.hdr.code = BCN_DROPDOWN;
+    BUTTON_SplitRects(infoPtr, &client, &label, &notify.rcButton);
+    SendMessageW(GetParent(infoPtr->hwnd), WM_NOTIFY, notify.hdr.idFrom, (LPARAM)&notify);
+}
