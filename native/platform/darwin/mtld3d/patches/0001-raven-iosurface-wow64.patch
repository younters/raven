new file mode 100644
index 0000000..9ecbc65
--- /dev/null
+++ b/unix/shared/src/raven_address.rs
@@ -0,0 +1,57 @@
+//! Checked guest/native address translation for Raven's two PE widths.
+use core::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+pub type Check = extern "C" fn(u64, u64, u32) -> i32;
+static BASE: AtomicU64 = AtomicU64::new(0);
+static CHECK: AtomicUsize = AtomicUsize::new(0);
+pub fn set_base(base: u64) { BASE.store(base, Ordering::Release); }
+pub fn set_check(check: Check) { CHECK.store(check as usize, Ordering::Release); }
+pub fn host_in(base: u64, address: u64, size: u64) -> Option<u64> {
+    if size > isize::MAX as u64 || address.checked_add(size).is_none() { return None; }
+    if address == 0 { return if size == 0 { Some(0) } else { None }; }
+    if base != 0 && address <= u32::MAX as u64 {
+        if size > (1u64 << 32) - address { return None; }
+        base.checked_add(address).and_then(|host| host.checked_add(size).map(|_| host))
+    } else { Some(address) }
+}
+pub fn checked(address: u64, size: u64, write: bool) -> Option<u64> {
+    let address = host_in(BASE.load(Ordering::Acquire), address, size)?;
+    if size == 0 { return Some(address); }
+    let callback = CHECK.load(Ordering::Acquire);
+    if callback == 0 {
+        // PE memory faults already belong to the Windows guest. The native
+        // unix library must instead receive Raven's range validator at load.
+        #[cfg(target_os = "windows")]
+        return Some(address);
+        #[cfg(not(target_os = "windows"))]
+        return None;
+    }
+    let check: Check = unsafe { core::mem::transmute(callback) };
+    if check(address, size, u32::from(write)) == 0 { None } else { Some(address) }
+}
+#[derive(Debug)]
+pub struct AccessViolation;
+pub fn host<T>(address: u64, count: usize, write: bool) -> u64 {
+    let size = count.checked_mul(size_of::<T>()).and_then(|v| u64::try_from(v).ok());
+    match size.and_then(|size| checked(address, size, write)) {
+        Some(0) if count == 0 => align_of::<T>() as u64,
+        Some(value) => value,
+        None => std::panic::panic_any(AccessViolation),
+    }
+}
+pub fn guest(address: u64) -> u64 {
+    let base = BASE.load(Ordering::Acquire);
+    if base != 0 && address >= base && address - base <= u32::MAX as u64 { address - base } else { address }
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn translation_checks_extent_and_overflow() {
+        let base = 0x7000000000;
+        assert_eq!(host_in(base, 0xfffffff0, 16), Some(base + 0xfffffff0));
+        assert_eq!(host_in(base, 0xfffffff0, 17), None);
+        assert_eq!(host_in(0, u64::MAX - 3, 8), None);
+        assert_eq!(host_in(u64::MAX - 8, 4, 8), None);
+        assert_eq!(host_in(base, 0, 1), None);
+        assert_eq!(host_in(base, 0, 0), Some(0));
+        assert_eq!(host_in(base, base + 0x10000, 8), Some(base + 0x10000));
+    }
+}
