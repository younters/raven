diff --git a/unix/unix/src/raven.rs b/unix/unix/src/raven.rs
new file mode 100644
index 0000000..ffb283e
--- /dev/null
+++ b/unix/unix/src/raven.rs
@@ -0,0 +1,40 @@
+use core::ffi::c_void;
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct Callbacks {
+    pub version: u32,
+    pub size: u32,
+    pub create: unsafe extern "C" fn(u64, *mut c_void, u32, u32) -> *mut c_void,
+    pub release: unsafe extern "C" fn(*mut c_void),
+    pub present: unsafe extern "C" fn(*mut c_void, *mut c_void, f64) -> i32,
+}
+static CALLBACKS: std::sync::OnceLock<Callbacks> = std::sync::OnceLock::new();
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn raven_mtld3d_bind(callbacks: *const Callbacks) -> i32 {
+    if callbacks.is_null() { return -1; }
+    let value = unsafe { callbacks.read() };
+    if value.version != 1 || value.size as usize != size_of::<Callbacks>() { return -1; }
+    if let Some(old) = CALLBACKS.get() {
+        return if old.create as usize == value.create as usize && old.release as usize == value.release as usize &&
+            old.present as usize == value.present as usize { 0 } else { -1 };
+    }
+    if CALLBACKS.set(value).is_ok() { 0 } else { -1 }
+}
+pub unsafe fn raven_mtld3d_layer_create(hwnd: u64, device: *mut c_void, width: u32, height: u32) -> *mut c_void {
+    unsafe { (CALLBACKS.get().expect("Raven callbacks").create)(hwnd, device, width, height) }
+}
+pub unsafe fn raven_mtld3d_layer_release(layer: *mut c_void) {
+    unsafe { (CALLBACKS.get().expect("Raven callbacks").release)(layer) }
+}
+pub unsafe fn raven_mtld3d_present(command: *mut c_void, drawable: *mut c_void, duration: f64) -> i32 {
+    unsafe { (CALLBACKS.get().expect("Raven callbacks").present)(command, drawable, duration) }
+}
+#[unsafe(no_mangle)]
+pub extern "C" fn raven_mtld3d_set_guest_base(base: u64) { mtld3d_shared::raven_address::set_base(base); }
+
+const _: () = {
+    assert!(size_of::<Callbacks>() == 32);
