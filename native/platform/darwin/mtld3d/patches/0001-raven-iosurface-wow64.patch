diff --git a/unix/shared/src/raven_address.rs b/unix/shared/src/raven_address.rs
new file mode 100644
index 0000000..a1f4a8b
--- /dev/null
+++ b/unix/shared/src/raven_address.rs
@@ -0,0 +1,36 @@
+//! Raven WoW64 address window. Wire scalars and opaque native handles stay unchanged.
+//! Only guest-memory fields call these helpers. Both PE ABIs already use u64 wire fields.
+use core::sync::atomic::{AtomicU64, Ordering};
+static BASE: AtomicU64 = AtomicU64::new(0);
+pub fn set_base(base: u64) { BASE.store(base, Ordering::Release); }
+fn host_in(base: u64, address: u64) -> u64 {
+    if address != 0 && address <= u32::MAX as u64 { base + address } else { address }
+}
+fn guest_in(base: u64, address: u64) -> u64 {
+    if base != 0 && address >= base && address - base <= u32::MAX as u64 { address - base } else { address }
+}
+pub fn host(address: u64) -> u64 { host_in(BASE.load(Ordering::Acquire), address) }
+pub fn guest(address: u64) -> u64 { guest_in(BASE.load(Ordering::Acquire), address) }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn guest_fields_round_trip_without_truncating_native_handles() {
+        let base = 0x7000000000;
+        for address in [1, 0x10000, 0x80000000, u32::MAX as u64] {
+            assert_eq!(host_in(base, address), base + address);
+            assert_eq!(guest_in(base, host_in(base, address)), address);
+        }
+        assert_eq!(host_in(base, 0), 0);
+        assert_eq!(guest_in(base, 0), 0);
+        for native in [0x100000000, 0x123456789, base - 1, base + 0x100000000] {
+            assert_eq!(host_in(base, native), native);
+            assert_eq!(guest_in(base, native), native);
+        }
+        for x64 in [0, 1, 0xffffffff, 0x100000000, 0x123456789] {
+            assert_eq!(host_in(0, x64), x64);
+            assert_eq!(guest_in(0, x64), x64);
+        }
+    }
+}
