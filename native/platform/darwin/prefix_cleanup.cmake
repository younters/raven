# Clean each build-owned prefix after its final consumer, including failures and
# timeouts. CTest automatically includes cleanup fixtures for filtered runs.
foreach(native_test IN LISTS native_tests)
    get_test_property(${native_test} ENVIRONMENT native_test_environment)
    if("${native_test_environment}" MATCHES "(^|;)RAVEN_PREFIX=([^;]+)")
        set(test_prefix "${CMAKE_MATCH_2}")
        cmake_path(IS_PREFIX CMAKE_CURRENT_BINARY_DIR "${test_prefix}" NORMALIZE owned_prefix)
        if(owned_prefix AND NOT test_prefix STREQUAL CMAKE_CURRENT_BINARY_DIR)
            string(MD5 prefix_id "${test_prefix}")
            set(prefix_cleanup "native_prefix_cleanup_${prefix_id}")
            if(NOT TEST ${prefix_cleanup})
                add_test(NAME ${prefix_cleanup} COMMAND ${CMAKE_COMMAND} -E rm -rf "${test_prefix}")
                set_tests_properties(${prefix_cleanup} PROPERTIES FIXTURES_CLEANUP "prefix_${prefix_id}" LABELS "prefix-cleanup")
            endif()
            set_property(TEST ${native_test} APPEND PROPERTY FIXTURES_REQUIRED "prefix_${prefix_id}")
        endif()
    endif()
endforeach()
