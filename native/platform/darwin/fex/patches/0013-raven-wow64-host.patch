+
+#ifdef RAVEN_HOST
+extern "C" NTSTATUS RavenWow64ProcessInit(const RavenWow64HostV1 *Host) {
+  if (WowHost || !Host || Host->size != sizeof(*Host) || Host->version != 1 || !Host->teb32) return STATUS_INVALID_PARAMETER;
+  const auto &H = Host->common;
+  if (H.size != sizeof(H) || H.version != 1 || H.flags || !H.guest32_base || (H.guest32_base & 0xffffffffULL) ||
+      !H.cpu_area || !H.dispatch || !H.exception || !H.jit_write_protect || !H.allocate_native_jit || !H.log || !H.unix_call) return STATUS_INVALID_PARAMETER;
+  WowHost = Host;
+  RavenHost = &Host->common;
+  BTCpuProcessInit();
+  return STATUS_SUCCESS;
+}
+extern "C" void RavenWow64Run() {
+  const auto TLS = GetTLS();
+  TLS.ControlWord().fetch_or(ControlBits::WOW_CPU_AREA_DIRTY, std::memory_order::relaxed);
+  Context::LockJITContext(TLS);
+  CTX->ExecuteThread(TLS.ThreadState());
+  Context::UnlockJITContext(TLS);
+}
+extern "C" NTSTATUS RavenHandleFault(EXCEPTION_RECORD *Record, CONTEXT *Native) {
+  EXCEPTION_POINTERS Pointers {Record, Native};
+  return BTCpuResetToConsistentStateImpl(&Pointers) ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+#endif
