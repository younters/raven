+// SPDX-License-Identifier: MIT
+#pragma once
+#include "RavenHost.h"
+// common CPU-area/dispatch/exception pointers designate WOW64_CONTEXT in this
+// separately negotiated interface. Native callbacks; no Wine CPU-area layout.
+struct RavenWow64HostV1 {
+  uint32_t size, version;
+  RavenHostV1 common;
+  uint64_t (*teb32)(void *native_teb);
+};
