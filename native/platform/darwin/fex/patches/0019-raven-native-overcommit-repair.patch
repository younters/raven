diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
index 50adf36..0d7fc50 100644
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -1341,3 +1341,15 @@ BOOLEAN BTCpu64IsProcessorFeaturePresent(UINT Feature) {
 void UpdateProcessorInformation(SYSTEM_CPU_INFORMATION* Info) {
   CPUFeatures->UpdateInformation(Info);
 }
+
+#ifdef RAVEN_HOST
+// Qualification probes use the actual tracker and CRT allocator of this module.
+extern "C" uint64_t RavenTestOvercommit(uint64_t Address, uint64_t Size, uint64_t Value) {
+  OvercommitTracker->MarkRange(Address, Size);
+  *reinterpret_cast<volatile uint64_t*>(Address) = Value;
+  OvercommitTracker->UnmarkRange(Address, Size);
+  return *reinterpret_cast<volatile uint64_t*>(Address);
+}
+extern "C" void *RavenTestAllocate(uint64_t Size) { return malloc(Size); }
+extern "C" void RavenTestFree(void *Pointer) { free(Pointer); }
+#endif
