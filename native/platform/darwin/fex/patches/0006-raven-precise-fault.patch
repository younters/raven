+#ifdef RAVEN_HOST
+extern "C" NTSTATUS RavenHandleFault(EXCEPTION_RECORD *Record, ARM64_NT_CONTEXT *Native) {
+  if (!RavenHost || !Record || !Native) return STATUS_INVALID_PARAMETER;
+  const auto Area = GetCPUArea();
+  auto *Thread = Area.ThreadState();
+  if (!Thread) return STATUS_NOT_SUPPORTED;
+  if (Record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
+      FEX::Windows::JITGuardPage::HandleJITGuardPage(Thread,
+        reinterpret_cast<void*>(Record->ExceptionInformation[1]), Native->X,
+        reinterpret_cast<__uint128_t*>(Native->V), &Native->Pc)) return STATUS_SUCCESS;
+  if (!CTX->IsAddressInCodeBuffer(Thread, Native->Pc) && !IsDispatcherAddress(Native->Pc)) return STATUS_NOT_SUPPORTED;
+  if (!IsDispatcherAddress(Native->Pc)) Exception::ReconstructThreadState(Thread, *Native);
+  auto &Context = Exception::StoreRavenContext(Thread, Native->Fpcr, Native->Fpsr);
+  Record->ExceptionAddress = reinterpret_cast<void*>(Context.Rip);
+  const auto Status = RavenInvoke(reinterpret_cast<uintptr_t>(RavenHost->exception),
+    reinterpret_cast<uintptr_t>(Record), reinterpret_cast<uintptr_t>(&Context), reinterpret_cast<uintptr_t>(Native));
+  if (Status) return Status;
+  Native->Pc = reinterpret_cast<uintptr_t>(&BeginSimulation);
+  Native->Sp = Area.EmulatorStackBase();
+  Native->X18 = reinterpret_cast<uintptr_t>(NtCurrentTeb());
+  return STATUS_SUCCESS;
+}
+#endif
 
