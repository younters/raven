+// Raven Tier 0: #DE is required for both zero divisor and quotient overflow.
+// This guard precedes Div/UDiv, so RA's no-upper-input folding cannot remove it.
+DEF_OP(CheckDiv) {
+  const auto Op = IROp->C<IR::IROp_CheckDiv>();
+  const auto X = ARMEmitter::Size::i64Bit;
+  ARMEmitter::ForwardLabel Fault, Valid, Done;
+  // Preserve incoming guest flags on both success and fault. No architectural
+  // register is updated until the check succeeds. ResetStack handles fault exit.
+  sub(X, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 64);
+  mrs(TMP4, ARMEmitter::SystemRegister::NZCV);
+  str(TMP4, ARMEmitter::Reg::rsp, 0);
+  mov(X, TMP1, GetReg(Op->Lower));
+  mov(X, TMP2, GetReg(Op->Upper));
+  if (Op->Bits < 64) {
+    ubfx(X, TMP3, GetReg(Op->Divisor), 0, Op->Bits);
+  } else {
+    mov(X, TMP3, GetReg(Op->Divisor));
+  }
+  cbz(X, TMP3, &Fault);
+  if (!Op->Signed) {
+    if (Op->Bits == 8) {
+      ubfx(X, TMP2, TMP1, 8, 8);
+    } else if (Op->Bits < 64) {
+      ubfx(X, TMP2, TMP2, 0, Op->Bits);
+    }
+    // For an unsigned 2n/n division, quotient fits iff high < divisor.
+    cmp(X, TMP2, TMP3);
+    b(ARMEmitter::Condition::CC_HS, &Fault);
+  } else if (Op->Bits < 64) {
+    if (Op->Bits == 8) {
+      sbfx(X, TMP1, TMP1, 0, 16);
+    } else {
+      ubfx(X, TMP1, TMP1, 0, Op->Bits);
+      bfi(X, TMP1, TMP2, Op->Bits, Op->Bits);
+      if (Op->Bits == 16) sbfx(X, TMP1, TMP1, 0, 32);
+    }
+    sbfx(X, TMP3, TMP3, 0, Op->Bits);
+    sdiv(X, TMP2, TMP1, TMP3);
+    sbfx(X, TMP4, TMP2, 0, Op->Bits);
+    cmp(X, TMP2, TMP4);
+    b(ARMEmitter::Condition::CC_NE, &Fault);
+  } else {
+    // Compare |128-bit dividend| against |divisor| * (max_magnitude + 1).
+    // Positive quotient max=2^63-1, negative quotient max magnitude=2^63.
+    eor(X, TMP4, TMP2, TMP3);
+    lsr(X, TMP4, TMP4, 63);
+    str(TMP4, ARMEmitter::Reg::rsp, 16);
+    ARMEmitter::ForwardLabel AbsDone, ThresholdDone;
+    tbz(TMP2, 63, &AbsDone);
+    subs(X, TMP1, ARMEmitter::Reg::zr, TMP1);
+    sbc(X, TMP2, ARMEmitter::Reg::zr, TMP2);
+    Bind(&AbsDone);
+    str(TMP1, ARMEmitter::Reg::rsp, 32);
+    str(TMP2, ARMEmitter::Reg::rsp, 40);
+    cmp(X, TMP3, 0);
+    cneg(X, TMP3, TMP3, ARMEmitter::Condition::CC_MI);
+    lsl(X, TMP1, TMP3, 63);
+    lsr(X, TMP2, TMP3, 1);
+    ldr(TMP4, ARMEmitter::Reg::rsp, 16);
+    cbz(X, TMP4, &ThresholdDone);
+    adds(X, TMP1, TMP1, TMP3);
+    adc(X, TMP2, TMP2, ARMEmitter::Reg::zr);
+    Bind(&ThresholdDone);
+    ldr(TMP3, ARMEmitter::Reg::rsp, 40);
+    cmp(X, TMP3, TMP2);
+    b(ARMEmitter::Condition::CC_HI, &Fault);
+    b(ARMEmitter::Condition::CC_LO, &Valid);
+    ldr(TMP3, ARMEmitter::Reg::rsp, 32);
+    cmp(X, TMP3, TMP1);
+    b(ARMEmitter::Condition::CC_HS, &Fault);
+  }
+  Bind(&Valid);
+  ldr(TMP4, ARMEmitter::Reg::rsp, 0);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP4);
+  add(X, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 64);
+  b(&Done);
+  Bind(&Fault);
+  ldr(TMP4, ARMEmitter::Reg::rsp, 0);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP4);
+  add(X, ARMEmitter::Reg::rsp, ARMEmitter::Reg::rsp, 64);
+  str(GetReg(Op->RIP).X(), STATE, offsetof(FEXCore::Core::CPUState, rip));
+  EmitSynchronousFault({.ErrorRegister = 0, .Signal = Core::FAULT_SIGTRAP,
+                        .TrapNumber = FEXCore::X86State::X86_TRAPNO_DE, .si_code = 1});
+  Bind(&Done);
+}
