 }
 extern "C" NTSTATUS RavenHandleFault(EXCEPTION_RECORD *Record, CONTEXT *Native) {
+  const auto Thread = GetTLS().ThreadState();
+  if (!Thread) return STATUS_NOT_SUPPORTED;
+  if (Record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION && !IsAddressInJit(Native->Pc)) return STATUS_NOT_SUPPORTED;
+  const bool Doorbell = IsAddressInJit(Native->Pc) && *reinterpret_cast<const uint32_t*>(Native->Pc) == (0xd4200000u | (0xcafeu << 5)) &&
+                        Thread->CurrentFrame->SuspendDoorbell;
+  if (Record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION &&
+      !Thread->CurrentFrame->SynchronousFaultData.FaultToTopAndGeneratedException && !Doorbell) return STATUS_NOT_SUPPORTED;
   EXCEPTION_POINTERS Pointers {Record, Native};
   return BTCpuResetToConsistentStateImpl(&Pointers) ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
 }
