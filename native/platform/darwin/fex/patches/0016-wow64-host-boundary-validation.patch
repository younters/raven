+// JIT buffer overflow can fault in FEX's native compiler. Only executable
+// sections of this module may use that repair path; Mach-O host code may not.
+static bool RavenIsModuleCode(uint64_t PC) {
+  extern IMAGE_DOS_HEADER __ImageBase;
+  const auto Base = reinterpret_cast<uintptr_t>(&__ImageBase);
+  const auto NT = reinterpret_cast<const IMAGE_NT_HEADERS64*>(Base + __ImageBase.e_lfanew);
+  const auto Sections = IMAGE_FIRST_SECTION(NT);
+  for (unsigned I = 0; I < NT->FileHeader.NumberOfSections; ++I) {
+    const auto &S = Sections[I];
+    if ((S.Characteristics & IMAGE_SCN_MEM_EXECUTE) && PC >= Base + S.VirtualAddress &&
+        PC - Base - S.VirtualAddress < S.Misc.VirtualSize) return true;
+  }
+  return false;
+}
 extern "C" NTSTATUS RavenHandleFault(EXCEPTION_RECORD *Record, CONTEXT *Native) {
+  const auto Thread = GetTLS().ThreadState();
+  if (!Thread) return STATUS_NOT_SUPPORTED;
+  if (!IsAddressInJit(Native->Pc)) {
+    if (Record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && RavenIsModuleCode(Native->Pc) &&
+        FEX::Windows::JITGuardPage::HandleJITGuardPage(Thread,
+          reinterpret_cast<void*>(Record->ExceptionInformation[1]), Native->X,
+          reinterpret_cast<__uint128_t*>(Native->V), &Native->Pc)) return STATUS_SUCCESS;
+    return STATUS_NOT_SUPPORTED;
+  }
+  const bool Doorbell = IsAddressInJit(Native->Pc) && *reinterpret_cast<const uint32_t*>(Native->Pc) == (0xd4200000u | (0xcafeu << 5)) &&
+                        Thread->CurrentFrame->SuspendDoorbell;
+  if (Record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION &&
+      !Thread->CurrentFrame->SynchronousFaultData.FaultToTopAndGeneratedException && !Doorbell) return STATUS_NOT_SUPPORTED;
   EXCEPTION_POINTERS Pointers {Record, Native};
   return BTCpuResetToConsistentStateImpl(&Pointers) ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
 }
