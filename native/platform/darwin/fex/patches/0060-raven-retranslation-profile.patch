 #ifdef FEX_RAVEN_DIVIDE
 // Opt-in counters for measuring translation separately from guest execution.
+static std::mutex RavenProfileMutex;
+static std::map<uint64_t, uint64_t> RavenCompileAddresses;
+static std::map<std::tuple<uint64_t, uint64_t, uint64_t>, uint64_t> RavenInvalidations;
 static std::atomic<bool> RavenCompileTimingEnabled {false};
 static std::atomic<uint64_t> RavenCompileCount {0}, RavenCompileNS {0};
+extern "C" void RavenRecordInvalidation(uint64_t Reason, uint64_t Start, uint64_t Size) {
+  if (!RavenCompileTimingEnabled.load(std::memory_order_relaxed)) return;
+  std::scoped_lock Lock(RavenProfileMutex);
+  ++RavenInvalidations[{Reason, Start, Size}];
+}
 extern "C" void RavenCompileProfile(uint64_t Enable, uint64_t* Values) {
   RavenCompileTimingEnabled.store(Enable != 0, std::memory_order_relaxed);
   if (Values) {
     Values[0] = RavenCompileCount.load(std::memory_order_relaxed);
     Values[1] = RavenCompileNS.load(std::memory_order_relaxed);
+    std::scoped_lock Lock(RavenProfileMutex);
+    // Page buckets retain unique RIP counts, repeated attempts and multiply compiled RIPs.
+    std::map<uint64_t, std::array<uint64_t, 3>> Pages;
+    for (auto [RIP, Count] : RavenCompileAddresses) {
+      auto &Page = Pages[RIP & ~uint64_t(4095)];
+      ++Page[0]; Page[1] += Count - 1; Page[2] += Count > 1;
+    }
+    for (auto [Page, Counts] : Pages)
+      LogMan::Msg::IFmt("Raven translations page={:x} unique={} repeated={} recompiled={}", Page, Counts[0], Counts[1], Counts[2]);
+    for (auto [Key, Count] : RavenInvalidations) {
+      auto [Reason, Start, Size] = Key;
+      LogMan::Msg::IFmt("Raven invalidation reason={} start={:x} size={} count={}", Reason, Start, Size, Count);
+    }
   }
 }
 struct RavenCompileTimer {
