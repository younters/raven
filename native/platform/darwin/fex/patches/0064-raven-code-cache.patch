+      return false;
+    }
+    uint64_t Offset = 0;
+    while (Offset + RecordHeader <= Tail.size()) {
+      MesaFOZ::foz_payload_header Header;
+      memcpy(&Header, Tail.data() + Offset + sizeof(MesaFOZ::foz_payload_key), sizeof(Header));
+      if (Header.payload_size > Tail.size() - Offset - RecordHeader) {
+        break;
+      }
+      Offset += RecordHeader + Header.payload_size;
