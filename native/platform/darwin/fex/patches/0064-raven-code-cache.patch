+extern "C" bool RavenDiskCacheControl(uint64_t Op, uint64_t* Values);
+// Op 1: register the guest image at (Address, Size); returns its qualifying section count.
+// Op 2: stats into Values[0..6]; op 3: flush queued stores first. Return 0 when the cache is off.
+extern "C" uint64_t RavenCodeCache(uint64_t Op, uint64_t Address, uint64_t Size) {
+  uint64_t Values[7] {};
+  if (!RavenDiskCacheControl(2, Values) || !Values[6]) {
+    return 0;
+  }
+  if (Op == 1) {
+    std::scoped_lock Lock(ThreadCreationMutex);
+    return ImageTracker->RegisterRavenImage(Address, Size);
+  }
+  if ((Op == 2 || Op == 3) && Address) {
+    RavenDiskCacheControl(Op, reinterpret_cast<uint64_t*>(Address));
+    return 1;
+  }
+  return 0;
+}
 
