+  void DiskCache::RavenFlush() {
+    if (!Writer) {
+      return;
+    }
+    // Poll rather than wait on a condition variable: this runs on a Raven host thread.
+    auto Done = fextl::make_shared<std::atomic<bool>>(false);
+    Writer->QueueWork(fextl::make_unique<FlushWorkItem>(Done));
+    // Bounded: exit must not wait long on a writer queued behind other processes' locks.
+    const auto Deadline = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+    while (!Done->load(std::memory_order_acquire) && std::chrono::steady_clock::now() < Deadline) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+  }
