+}
+
+void ImageTracker::MarkRavenModified(uint64_t Address, uint64_t Size) {
+  std::unique_lock Lk {ImagesLock};
+  auto It = MappedImages.upper_bound(Address);
+  if (It != MappedImages.begin()) {
+    --It;
+  }
+  for (; It != MappedImages.end() && It->first < Address + Size; ++It) {
+    if (It->second.SectionEnd > Address) {
+      It->second.Modified = true;
+    }
+  }
+}
+
+void ImageTracker::UnregisterRavenRange(uint64_t Address, uint64_t Size) {
+  // Lookups return references into these nodes; compilation holds the invalidation lock shared.
+  std::scoped_lock Lock(CTX.GetCodeInvalidationMutex());
+  std::unique_lock Lk {ImagesLock};
+  auto It = MappedImages.lower_bound(Address);
+  while (It != MappedImages.end() && It->first < Address + Size) {
+    It = MappedImages.erase(It);
+  }
+}
