+extern "C" void RavenGetYmmHigh(void *Buffer) {
+  alignas(16) __uint128_t Low[16], High[16];
+  CTX->ReconstructXMMRegisters(GetCPUArea().ThreadState(), Low, High);
+  memcpy(Buffer, High, sizeof(High));
+}
+extern "C" void RavenSetYmmHigh(const void *Buffer) {
+  auto *Thread = GetCPUArea().ThreadState();
+  alignas(16) __uint128_t Low[16], High[16];
+  CTX->ReconstructXMMRegisters(Thread, Low, High);
+  memcpy(High, Buffer, sizeof(High));
+  CTX->SetXMMRegistersFromState(Thread, Low, High);
+}
