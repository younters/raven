+++ b/Source/Windows/Common/Priv.h
@@ -3,8 +3,16 @@
 
 #include <exception>
 #include <winternl.h>
+#ifdef RAVEN_HOST
+#include "RavenHost.h"
+#endif
 
 static inline __TEB* GetCurrentTEB() {
+#ifdef RAVEN_HOST
+  // Module WinAPI state (TLS, last-error and identity) belongs to the host
+  // worker. Direct NtCurrentTeb() in the execution frontend remains the guest.
+  if (RavenHost) return reinterpret_cast<__TEB*>(RavenInvoke(reinterpret_cast<uintptr_t>(RavenHost->private_teb), 0, 0, 0));
+#endif
   return reinterpret_cast<__TEB*>(NtCurrentTeb());
 }
 
